# Nnọọ environment reference (docs/neon/02-neon-config-and-environments.md §4).
# Placeholders only. Real values live in gitignored files (.env.local, .local/*.env),
# the Neon function env (set by `neon deploy --env <file>`) and CI secrets.
# Every process validates these at boot (packages/config/src/env.ts); a missing or
# unsafe value is a crash, never a fallback. There is NO default for NNOO_ENV.

# ── Which environment this process is ───────────────────────────────────────────
# local | test | preview | staging | production. Fake providers are refused outside local/test.
NNOO_ENV=local

# ── Database (ADR-026) ────────────────────────────────────────────────────────────
# Runtime role on the POOLED host. Must log in as nnoo_app_login (never the owner).
# Create the login role with SQL as the owner, NOT with `neon roles create`: CLI-created
# roles are members of neon_superuser (docs/neon/07 §4). Use sslmode=verify-full.
APP_DATABASE_URL=postgresql://nnoo_app_login:<password>@<endpoint>-pooler.<region>.aws.neon.tech/nnoo?sslmode=verify-full
# Owner role on the DIRECT host, for `pnpm db:migrate` only. Runtime code never reads it.
MIGRATION_DATABASE_URL=postgresql://nnoo_owner:<password>@<endpoint>.<region>.aws.neon.tech/nnoo?sslmode=verify-full
# Optional override of the project id read from .neon (CI sets this).
# NEON_PROJECT_ID=

# ── Authentication (ADR-028: Better Auth as a library in `api`) ──────────────────
# ≥ 32 random characters. Signs cookies and encrypts the JWKS private keys. Rotate on incident.
AUTH_SECRET=<generate: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))">
# Public base URL of the API (the edge URL in preview/staging/production; https required in production).
AUTH_BASE_URL=http://localhost:8787
# Comma-separated browser origins allowed to use cookie-based sign-in and refresh.
AUTH_TRUSTED_ORIGINS=http://localhost:5173
# Passkey relying party: the registrable domain shared by the API and the web app (e.g. nnoo.app).
# Optional; defaults to the AUTH_BASE_URL host. Boot fails if a trusted origin is outside it.
# AUTH_RP_ID=

# ── Edge (ADR-023) ────────────────────────────────────────────────────────────────
# Shared secret(s) the edge proxy sends as X-Edge-Auth. Two values (comma) during rotation.
EDGE_AUTH_SECRETS=<generate: ≥ 32 random characters>
# Comma-separated browser origins for CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Minimum client versions per platform, JSON. Older clients receive 426.
MIN_CLIENT_VERSIONS={"mobile":"0.0.0"}

# ── Providers (ports, 02 §8) ──────────────────────────────────────────────────────
# fake (local/test only: codes go to <cwd>/.local/otp-inbox.jsonl) | none (channel off, 503;
# not allowed in production) | termii | twilio (adapters not implemented yet: boot fails).
SMS_PROVIDER=fake
# fake | none | resend | smtp (real adapters not implemented yet).
EMAIL_PROVIDER=fake

# ── Object Storage (ADR-020/032) ──────────────────────────────────────────────────
# s3 (Neon Object Storage; Neon injects AWS_* into deployed functions) | fake (in-memory, local/test only).
STORAGE_PROVIDER=fake
# For s3 locally: neon env pull --branch dev/<you> --service object-storage --file .local/storage.env
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=

# ── Audio worker (ADR-021) ────────────────────────────────────────────────────────
# jobs function only: secret(s) the worker presents to claim jobs (two during rotation).
AUDIO_WORKER_KEYS=<generate: ≥ 32 random characters>

# ── Observability ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# SENTRY_DSN=

# ── Deploy-time only (read by neon.ts, not by the runtime) ──────────────────────────
# off disables schedule triggers on this branch (developer branches, to save compute hours).
NNOO_TRIGGERS=off

# ── Web app (apps/web) ────────────────────────────────────────────────────────────
# Public, baked into the bundle: the EDGE URL of the API (never the raw function URL).
# Leave empty locally: the Vite dev server proxies /v1 to API_PROXY_TARGET instead.
VITE_API_URL=
# Dev server only (never bundled): where /v1 is proxied, and the edge secret the proxy adds.
API_PROXY_TARGET=http://localhost:8787
