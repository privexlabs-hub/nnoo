{
  "name": "@nnoo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src tests",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "build": "tsx scripts/build.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "drizzle-kit check",
    "test:contract": "vitest run --project contract"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@better-auth/passkey": "1.7.12",
    "@neon/functions": "0.11.0",
    "@nnoo/config": "workspace:*",
    "@nnoo/contracts": "workspace:*",
    "@nnoo/igbo-text": "workspace:*",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "uuidv7": "1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "testcontainers": "12.2.1"
  }
}
